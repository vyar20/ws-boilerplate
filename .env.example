# Variable where app listen
PORT=3000

# Variable for postgresql connection string
DATABASE_URL=postgresql://postgres@localhost:5432/<your-databse>

# Better-Auth variables
BETTER_AUTH_BASE_URL=http://localhost:$PORT
BETTER_AUTH_SECRET=some-random-32-char-xxx-xxxx-xxxx-xxx # run `openssl rand --base64 32` to generate the secret