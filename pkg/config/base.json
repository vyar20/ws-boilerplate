{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext"
    ],
    "skipLibCheck": true,
    "erasableSyntaxOnly": false,
    "types": [
      "bun"
    ]
  }
}