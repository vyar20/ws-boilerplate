{
    "name": "backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "bun run development",
        "development": "NODE_ENV=development bun --hot src/app-dev.ts ",
        "start": "bun run prod",
        "prod": "NODE_ENV=production bun src/app-prod.ts",
        "db:seed": "NODE_ENV=development bun src/seed.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "bun test --path-ignore-patterns='**/*.integration.test.ts'",
        "test:integration": "NODE_ENV=development bun test integration",
        "del": "rm -rf node_modules dist"
    },
    "dependencies": {
        "@better-auth/prisma-adapter": "^1.7.6",
        "@hono/node-server": "^2.1.1",
        "@repo/api": "workspace:*",
        "@repo/db": "workspace:*",
        "@repo/env": "workspace:*",
        "@repo/utils": "workspace:*",
        "@repo/validations": "workspace:*",
        "hono": "^4.13.10",
        "vite": "^8.3.1"
    },
    "devDependencies": {
        "@repo/config": "workspace:*"
    }
}