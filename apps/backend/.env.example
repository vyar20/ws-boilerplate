# Backend environment variables
# Copy this file to `.env` and replace the values.
#   cp apps/backend/.env.example apps/backend/.env
# Validated in pkg/env/src/env.ts — the server won't start if any are missing/invalid.

# Port the server listens on (API + frontend are served here)
PORT=3000

# PostgreSQL connection string (must start with postgres:// or postgresql://)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# Secret used by Better Auth to sign sessions (min 32 chars)
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_to_a_random_string_at_least_32_chars

# Public base URL of the auth server (must start with http/https)
BETTER_AUTH_URL=http://localhost:3000

# OPTIONAL — app-level encryption key, not used by the code yet.
# Leave it commented out until you need it; if set, it must be at least 32 chars.
# Generate one with: openssl rand -base64 32
# ENCRYPTION_KEY=change_me_to_a_random_string_at_least_32_chars

# --- Seed only (bun run db:seed) — not part of the validated env schema ---
# Password for every seeded user. Must pass the password policy. If unset, a random
# one is generated and printed once at the end of the seed.
# SEED_PASSWORD=

# The seed refuses any DATABASE_URL host other than localhost/127.0.0.1/::1.
# Set to "true" to seed a non-local database (e.g. shared staging). NEVER production.
# ALLOW_SEED=true
