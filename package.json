{
    "name": "ws-boilerplate",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --filter \"*\" dev",
        "start": "bun --filter \"*\" start",
        "lint": "bun --filter \"*\" lint",
        "typecheck": "bun --filter \"*\" typecheck",
        "test": "bun --filter \"*\" test",
        "db:push": "bun --filter \"*\" db:push",
        "db:gen": "bun --filter \"*\" db:gen",
        "db:migrate": "bun --filter \"*\" db:migrate",
        "del": "find . -type d \\( -name node_modules -o -name dist \\) -exec rm -rf {} +"
    },
    "packageManager": "bun@1.4.4",
    "workspaces": [
        "apps/*",
        "pkg/*"
    ],
    "dependencies": {
        "better-auth": "^1.7.27",
        "date-fns": "^4.4.0",
        "hono": "^4.13.20",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "eslint": "^10.15.0",
        "jiti": "^2.7.0",
        "prettier": "^3.10.1"
    }
}