{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"backend": {
			"root": "apps/backend",
			"framework": "vite"
		},
		"frontend": {
			"root": "apps/frontend",
			"framework": "vite"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "frontend"
			}
		}
	]
}
