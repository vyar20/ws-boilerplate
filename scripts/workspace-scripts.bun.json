{
	"dev": "bun --filter '*' dev",
	"start": "bun --filter '*' start",
	"build": "bun --filter '*' build",
	"lint": "bun --filter '*' lint",
	"test": "bun --filter '*' test",
	"db:gen": "bun --filter '*' db:gen",
	"db:push": "bun --filter '*' db:push",
	"db:seed": "bun --filter '*' db:seed",
	"db:migrate": "bun --filter '*' db:migrate",
	"db:migrate:deploy": "bun --filter '*' db:migrate:deploy",
	"db:migrate:status": "bun --filter '*' db:migrate:status",
	"db:std": "bun --filter '*' db:std",
	"auth:gen": "bun --filter '*' auth:gen",
	"del": "bun --filter '*' del && rm -rf node_modules"
}
